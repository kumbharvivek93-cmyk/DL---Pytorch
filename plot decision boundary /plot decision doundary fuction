import numpy as np
import torch
import matplotlib.pyplot as plt


def plot_decision_boundary(
    model,
    X,
    y,
    scaler=None,
    threshold=0.5,
    resolution=300,
    padding=0.5,
    figsize=(10, 7),
    title="Decision Boundary",
    cmap="coolwarm",
    show_points=True
):
    # 1. Convert X and y to NumPy for plotting
    if isinstance(X, torch.Tensor):
        X_np = X.detach().cpu().numpy()
    else:
        X_np = np.asarray(X)

    if isinstance(y, torch.Tensor):
        y_np = y.detach().cpu().numpy().reshape(-1)
    else:
        y_np = np.asarray(y).reshape(-1)

    # This plot requires exactly two features
    if X_np.ndim != 2 or X_np.shape[1] != 2:
        raise ValueError("X must have exactly 2 features.")

    # 2. Identify the model's device
    try:
        device = next(model.parameters()).device
    except StopIteration:
        device = torch.device("cpu")

    # 3. Create a grid in the displayed feature space
    x_min = X_np[:, 0].min() - padding
    x_max = X_np[:, 0].max() + padding
    y_min = X_np[:, 1].min() - padding
    y_max = X_np[:, 1].max() + padding

    xx, yy = np.meshgrid(
        np.linspace(x_min, x_max, resolution),
        np.linspace(y_min, y_max, resolution)
    )

    grid = np.column_stack((xx.ravel(), yy.ravel()))

    # 4. Apply the SAME fitted scaler used during training
    model_grid = scaler.transform(grid) if scaler is not None else grid

    grid_tensor = torch.as_tensor(
        model_grid,
        dtype=torch.float32,
        device=device
    )

    # 5. Predict probabilities
    was_training = model.training
    model.eval()

    try:
        with torch.inference_mode():
            logits = model(grid_tensor)

            if logits.ndim == 1:
                logits = logits.unsqueeze(1)

            if logits.ndim != 2 or logits.shape[1] != 1:
                raise ValueError(
                    "Expected one logit per sample for binary classification."
                )

            probs = torch.sigmoid(logits).squeeze(1)
            Z = probs.cpu().numpy().reshape(xx.shape)
    finally:
        model.train(was_training)

    # 6. Draw the plot
    fig, ax = plt.subplots(figsize=figsize)

    filled = ax.contourf(
        xx, yy, Z,
        levels=np.linspace(0, 1, 21),
        cmap=cmap,
        alpha=0.65,
        vmin=0,
        vmax=1
    )

    # Draw the selected probability threshold
    ax.contour(
        xx, yy, Z,
        levels=[threshold],
        colors="black",
        linewidths=2
    )

    if show_points:
        scatter = ax.scatter(
            X_np[:, 0],
            X_np[:, 1],
            c=y_np,
            cmap=cmap,
            vmin=0,
            vmax=1,
            edgecolors="black",
            s=35
        )

    fig.colorbar(filled, ax=ax, label="Predicted probability of class 1")
    ax.set_xlabel("Feature 1")
    ax.set_ylabel("Feature 2")
    ax.set_title(title)
    plt.show()

    return fig, ax
